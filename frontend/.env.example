# URL backend OmniChat.
#
# NEXT_PUBLIC_* được nhúng vào bundle trình duyệt (client gọi trực tiếp
# /api/v1/...). API_BASE_URL chỉ dùng phía server trong Route Handler —
# tách riêng để sau này backend nằm sau mạng nội bộ thì đổi được một chỗ.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

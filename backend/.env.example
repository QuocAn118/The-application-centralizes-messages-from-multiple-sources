# Cơ sở dữ liệu — PostgreSQL 17 cài native trên Windows
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/omnichat
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/omnichat_test

# JWT — sinh khoá bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=thay-bang-khoa-that-truoc-khi-chay
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limit cho endpoint dang nhap
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Inbox — mã hoá credential kênh (Zalo/Meta token). Sinh khoá bằng:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_CIPHER_KEY=thay-bang-khoa-fernet-that-truoc-khi-chay
# Thư mục lưu tệp đính kèm tải về (dev: đĩa local, đã gitignore)
ATTACHMENT_STORAGE_DIR=var/attachments

# Inbox — bí mật cấp ứng dụng để verify chữ ký webhook (KHÔNG phải token kênh).
# Zalo: app id + OA secret key (mục Webhook trong Zalo OA).
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
# Meta: app secret (Settings > Basic của app Meta), dùng chung FB + IG.
META_APP_SECRET=
# Token tự đặt để Meta/Zalo verify webhook (GET hub.challenge); rỗng = bỏ qua.
WEBHOOK_VERIFY_TOKEN=

# CORS: origin cua frontend duoc phep goi API tu trinh duyet (ngan cach bang dau
# phay). Frontend chay o cong khac BAT BUOC co mat o day, neu khong trinh duyet
# chan tu buoc preflight. Khong dung "*" vi API dung Authorization + cookie.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ung dung
APP_ENV=development
LOG_LEVEL=INFO
